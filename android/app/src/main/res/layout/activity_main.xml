<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvAppTitle"
                android:text="Senior Fraud Shield"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/text_primary" />
        </RelativeLayout>

        <!-- Big Protection Status Card -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_box"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/ivShieldIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_shield"
                android:contentDescription="Shield"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shield_active"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/status_green_text"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_protected"
                android:textSize="16sp"
                android:textColor="@color/status_green_text"
                android:gravity="center" />
        </LinearLayout>

        <!-- Prominent Toggle Protection Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleProtection"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:text="@string/btn_stop_protection"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/btn_stop"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSpeakerphoneTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/speakerphone_tip"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Urgent Alert Card (Visible when Scam or Threat Detected) -->
        <LinearLayout
            android:id="@+id/cardAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_elder_card"
            android:padding="20dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_warning"
                    android:contentDescription="Urgent Warning" />

                <TextView
                    android:id="@+id/tvAlertTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="URGENT FRAUD ALERT"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_red_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAlertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hang_up_advice"
                android:textSize="17sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissAlert"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="I HUNG UP THE CALL"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/status_red_text"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Caller Intelligence Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_elder_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/caller_lookup_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="@string/caller_number_hint"
                    android:inputType="phone"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckCaller"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_check_caller"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/primary"
                android:textColor="#FFFFFF" />

            <!-- Lookup Result Display -->
            <TextView
                android:id="@+id/tvCallerResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="#F1F5F9" />
        </LinearLayout>

        <!-- Helpline Fast Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpline1930"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_helpline"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/btn_helpline"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
