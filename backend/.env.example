# =====================================================================
# ELDERSHIELD PRODUCTION BACKEND CONFIGURATION (.env)
# =====================================================================

# Server & Network
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & Rate Limiting
# When REQUIRE_AUTH=true, requests must include 'X-API-Key' or 'Authorization: Bearer <API_KEY>'
REQUIRE_AUTH=false
API_KEY=eldershield-production-key-hwv4
RATE_LIMIT_PER_MINUTE=120

# Audio & Speech Recognition Model (faster-whisper / Silero VAD)
MAX_AUDIO_UPLOAD_MB=25
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Session Management & Resource Bounds
SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_BUFFER_BYTES_PER_SESSION=10485760
MAX_CONCURRENT_SESSIONS=50

# Privacy & Structured Logging
LOG_LEVEL=INFO
ENABLE_JSON_LOGGING=false
MASK_LOG_PII=true

# Data Retention Policy (Zero persistence by default)
DATA_RETENTION_POLICY=EPHEMERAL_ZERO_DISK_RETENTION
